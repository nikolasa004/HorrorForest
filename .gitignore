# My terrain data
!/Assets/New Terrain*.asset
!/Assets/New Terrain*.asset.meta

!/Assets/TerrainData_*.asset
!/Assets/TerrainData_*.asset.meta

# My terrain layers
!/Assets/*.terrainlayer
!/Assets/*.terrainlayer.meta
